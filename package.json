{
  "name": "marketplace-mcp-fixture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fixture-only Marketplace MCP service",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
