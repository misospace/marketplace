{
  "name": "musebridge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=services/marketplace",
    "typecheck": "npm run typecheck --workspace=services/marketplace",
    "test": "npm run test --workspace=services/marketplace --",
    "lint": "npm run lint --workspace=services/marketplace",
    "start": "npm run start --workspace=services/marketplace"
  }
}
